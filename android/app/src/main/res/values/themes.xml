<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AirProject" parent="Theme.AppCompat" />

    <style name="Theme.AirProject.Slideshow" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="SlideshowOverlayText">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:shadowColor">#CC000000</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">8</item>
    </style>

    <style name="Theme.AirProject.Setup" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="colorAccent">#0A84FF</item>
    </style>

    <style name="SetupStepTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SetupStepStatus">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">40dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">#B0B8C4</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SetupButton" parent="Widget.AppCompat.Button.Colored">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
